{
  "name": "front-tailwind-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:workspace": "node ./scripts/build-workspace-packages.mjs",
    "prebuild": "npm run prepare:workspace",
    "build": "npm run prepare:vendor && npm run bundle:css && npm run bundle:js",
    "prebuild:css": "npm run prepare:workspace",
    "build:css": "npm run bundle:css",
    "bundle:css": "node ./scripts/build-css.mjs && node ./scripts/stamp-cache-version.mjs",
    "prebuild:js": "npm run prepare:workspace",
    "build:js": "npm run bundle:js",
    "bundle:js": "node ./scripts/build-js-bundle.mjs && node ./scripts/stamp-cache-version.mjs",
    "stamp:assets": "node ./scripts/stamp-cache-version.mjs",
    "prepare:vendor": "node ./scripts/prepare-runtime-deps.mjs",
    "pretypecheck": "npm run prepare:workspace",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:config-resolution": "node --import ./tests/helpers/register-jsx.mjs --test --test-force-exit tests/shared/config-resolution.test.mjs",
    "pretest": "npm run prepare:workspace",
    "test": "node --import ./tests/helpers/register-jsx.mjs --test --test-concurrency=2",
    "smoke": "node ./scripts/run-smokes.mjs",
    "watch:css": "node ./scripts/build-css.mjs --watch",
    "watch:js": "node ./scripts/build-js-bundle.mjs --watch",
    "smoke:workbench-settings": "node --import ./tests/helpers/register-jsx.mjs --test --test-force-exit tests/workbench/settings-domain.test.mjs tests/workbench/translation-settings.test.mjs tests/workbench/connector-settings.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@retainpdf/api": "0.1.0",
    "@retainpdf/contracts": "0.1.0",
    "@retainpdf/domain": "0.1.0",
    "@retainpdf/ui": "0.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.10",
    "pdfjs-dist": "^4.8.69",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
